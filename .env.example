# ========================================
# RSS Reader 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ========================================

# Gemini API Key (必填)
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-own-key

# 数据库连接 (Docker 部署时自动配置)
# 本地开发使用:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/rss_reader

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# JWT 密钥 (生产环境请使用强随机密钥)
SECRET_KEY=your-super-secret-key-change-it

# Token 过期时间 (分钟)
access_token_expire_minutes=120
